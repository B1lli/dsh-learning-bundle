{
  "name": "dsh-learning-bundle",
  "version": "0.4.0",
  "description": "Natural project teaching and first-delivery verification guidance using native DSH instructions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1lli/dsh-learning-bundle.git"
  },
  "homepage": "https://github.com/B1lli/dsh-learning-bundle#readme",
  "bugs": {
    "url": "https://github.com/B1lli/dsh-learning-bundle/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "correction-learning",
    "agent-memory",
    "agent-learning",
    "llm-evaluation",
    "cordis"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./src/index.js"
  },
  "bin": {
    "dsh-learning": "./scripts/learning.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "benchmark": "node scripts/run-benchmark.mjs --mode acceptance",
    "benchmark:baseline": "node scripts/run-benchmark.mjs --mode baseline",
    "benchmark:refresh": "node scripts/run-benchmark.mjs --mode acceptance --refresh-evidence",
    "benchmark:assemble": "node scripts/assemble-transcript.mjs",
    "benchmark:assemble:current": "DSH_EXPECTED_VERSION=0.1.1-rc.2 DSH_EXPECTED_TAG=dsh-v0.1.1-rc.2 DSH_EXPECTED_COMMIT=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e DSH_TRANSCRIPT_OUTPUT=assembled-transcript-current.json node scripts/assemble-transcript.mjs",
    "benchmark:live": "node scripts/run-live-semantic.mjs",
    "benchmark:scenarios": "node scripts/run-scenario-benchmark.mjs",
    "benchmark:scenarios:refresh": "node scripts/run-scenario-benchmark.mjs --refresh-evidence",
    "evidence:sanitize": "node scripts/sanitize-evidence.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:lifecycle": "node tests/disposable-lifecycle.mjs"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "fixtures/",
    "benchmark/",
    "tests/",
    "cordis.patch.yml",
    "README.md",
    "BENCHMARK.md",
    "docs/",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.1.2-rc.1 || 0.1.3-alpha.2",
      "profiles": [
        "headless"
      ],
      "dshReleases": {
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "unknown",
        "0.1.3-alpha.2": "compatible"
      },
      "dshOperations": {
        "0.1.2-rc.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.1.3-alpha.1": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.3-alpha.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      }
    }
  }
}
